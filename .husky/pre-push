set -e

echo "Running TypeScript checks"
pnpm typecheck

echo "Scanning outgoing commits for secrets"
. "$(dirname "$0")/gitleaks.sh"

remote="$1"
z=0000000000000000000000000000000000000000
rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z" ]; then
    continue
  fi
  if [ "$remote_sha" = "$z" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$local_sha --not --remotes=$remote"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! git rev-list $range >/dev/null 2>&1; then
    echo "pre-push: cannot resolve the range to scan ($range), refusing the push" >&2
    exit 1
  fi
  gitleaks git --redact --verbose --log-opts="$range" . || rc=1
done
exit "$rc"
